{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mildly-feral",
  "main": "worker/browser-worker.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/browser",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "mildly-feral.ben-tan.com", "custom_domain": true }],
  "observability": { "enabled": false }
}
